{
  "id": "v05",
  "title": "Phrasal Verbs",
  "intro": "A phrasal verb combines a standard verb with one or two prepositions/particles to generate a brand new idiomatic meaning. In WBPSC Clerkship, phrasal verbs built on 'break', 'bring', 'call', 'come', 'give', 'look', 'put', 'run', and 'take' appear routinely.",
  "bengali": "Phrasal Verbs (বা Group Verbs) হলো মূল Verb-এর সাথে Preposition বা Adverb যুক্ত হয়ে গঠিত নতুন অর্থপূর্ণ ক্রিয়াপদ। যেমন: 'Look' মানে তাকানো, কিন্তু 'Look into' মানে তদন্ত করা (investigate), 'Look for' মানে খোঁজা (search), এবং 'Look down upon' মানে ঘৃণা করা (despise)। ক্লার্কশিপ পরীক্ষায় phrasal verbs সবচেয়ে স্কোরিং কিন্তু অবহেলা করলে ভুলের সম্ভাবনাও বেশি।",
  "rules": [
    {
      "rule": "The 'BREAK' Family of Phrasal Verbs:",
      "examples": [
        "Break down: Mechanical failure or emotional collapse ('The bus broke down on Vidyasagar Setu').",
        "Break into: Enter a building illegally by force ('Thieves broke into the godown').",
        "Break out: Sudden eruption of war, fire, or epidemic ('Dengue broke out in the municipality').",
        "Break through: Make a major discovery or overcome an obstacle ('Scientists achieved a breakthrough').",
        "Break up: Terminate a relationship or disperse a meeting."
      ],
      "exceptions": [
        "Do not use 'break in' when referring to entering a specific premises forcefully; use 'break into'."
      ]
    },
    {
      "rule": "The 'CALL' Family of Phrasal Verbs:",
      "examples": [
        "Call off: Cancel a scheduled event ('The strike was called off after negotiations').",
        "Call on/upon: Visit a person formally ('The minister called on the Governor').",
        "Call at: Visit a place briefly ('The ship called at Colombo port').",
        "Call for: Demand or require as necessary ('Your misconduct calls for an explanation').",
        "Call up: Recollect memories or summon for military duty."
      ],
      "exceptions": [
        "'Call out' means to summon assistance or shout publicly."
      ]
    },
    {
      "rule": "The 'LOOK' Family of Phrasal Verbs:",
      "examples": [
        "Look into: Investigate thoroughly ('The police are looking into the embezzlement').",
        "Look for: Search for a misplaced object or employment ('He is looking for a government job').",
        "Look after: Care for someone ('She looks after her ailing grandmother').",
        "Look down upon: Regard with contempt or superiority ('Never look down upon the impoverished').",
        "Look forward to: Anticipate with pleasure (governs V-ing: 'looking forward to receiving your response')."
      ],
      "exceptions": [
        "'Look over' means inspect quickly; 'Look through' means examine thoroughly from start to finish."
      ]
    },
    {
      "rule": "The 'PUT' Family of Phrasal Verbs:",
      "examples": [
        "Put off: Postpone or delay ('The committee put off the meeting until Friday').",
        "Put out: Extinguish a flame or fire ('The firemen put out the blaze').",
        "Put up with: Tolerate or endure patiently ('I cannot put up with this insolence').",
        "Put on: Wear apparel or pretend ('He put on a solemn expression').",
        "Put down: Suppress by force or write down in a notebook."
      ],
      "exceptions": [
        "Do not confuse 'put out' (extinguish) with 'blow out' (extinguish by breath/wind)."
      ]
    },
    {
      "rule": "The 'BRING' and 'GIVE' Families of Phrasal Verbs:",
      "examples": [
        "Bring up: Rear/educate a child, or introduce a topic for discussion.",
        "Bring about: Cause to happen ('Reforms brought about economic revival').",
        "Give up: Renounce, abandon a habit ('He gave up smoking').",
        "Give in: Surrender, yield to pressure ('The rebels finally gave in').",
        "Give away: Distribute gifts/prizes or betray a secret."
      ],
      "exceptions": [
        "'Give out' means emit or become exhausted."
      ]
    }
  ],
  "commonMistakes": [
    "Writing 'Call of the strike' instead of 'Call off' (off with double 'f').",
    "Writing 'Put off the fire' instead of 'Put out the fire' (Put off = postpone; Put out = extinguish).",
    "Writing 'Look at' instead of 'Look into' for an investigation.",
    "Confusing 'Break into' (forceful entry) with 'Break out' (spread of disease/fire).",
    "Writing 'Put up with' when simply wearing clothes is intended ('put on')."
  ],
  "examTricks": [
    "Investigate = Look INTO.",
    "Cancel = Call OFF.",
    "Postpone = Put OFF.",
    "Extinguish = Put OUT.",
    "Tolerate = Put UP WITH.",
    "Spread (Disease/War/Fire) = Break OUT."
  ],
  "memoryTricks": [
    "PUT OUT the light (fire goes OUT).",
    "PUT OFF the meeting (push it OFF to later).",
    "CALL OFF the strike (strike is OFF)."
  ],
  "revision": [
    "Call off = cancel; Put off = postpone.",
    "Put out = extinguish; Put up with = tolerate.",
    "Break into = enter by force; Break out = spread suddenly.",
    "Look after = take care of; Look into = investigate.",
    "Give in = surrender; Give up = abandon."
  ],
