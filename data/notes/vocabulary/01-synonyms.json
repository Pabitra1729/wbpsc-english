{
  "id": "v01",
  "title": "Synonyms",
  "intro": "Synonyms are words with identical or closely related meanings within a given context. In competitive exams like WBPSC Clerkship, synonyms are tested not as isolated definitions but by assessing exact nuance, degree of intensity, tone (formal vs informal), and part of speech consistency.",
  "bengali": "Synonyms (সমার্থক শব্দ) হলো প্রায় একই অর্থবোধক শব্দ। পরীক্ষায় প্রায়শই আপাতদৃষ্টিতে কাছাকাছি চারটি শব্দের সূক্ষ্ম তারতম্য যাচাই করা হয়। সমার্থক শব্দ সমাধানের চাবিকাঠি: ১. শব্দের Part of Speech একই হতে হবে (Noun-এর Synonym Noun, Adjective-এর Synonym Adjective হবে)। ২. শব্দের Tone ইতিবাচক (Positive) নাকি নেতিবাচক (Negative) তা চিহ্নিত করা। ৩. Root Words (মূল শব্দাংশ) ও Prefix/Suffix ধরে শব্দের মূল ভাব অনুমান করা।",
  "rules": [
    {
      "rule": "Part of Speech Consistency: A synonym must always correspond to the identical grammatical category of the target word.",
      "examples": [
        "Adjective: 'Candid' (frank, forthright) -> Synonym: 'Blunt' or 'Open' (Adjective).",
        "Noun: 'Candour' (openness, frankness) -> Synonym: 'Frankness' (Noun).",
        "Adverb: 'Candidly' (openly) -> Synonym: 'Honestly' (Adverb)."
      ],
      "exceptions": [
        "Do not select an adjective option when the target word is a noun."
      ]
    },
    {
      "rule": "Tone and Connotation Analysis: Identify whether the target word has a positive (+), neutral (0), or negative (-) emotional weight.",
      "examples": [
        "Positive: 'Thrifty' / 'Frugal' (prudent, wise spending).",
        "Negative: 'Miserly' / 'Parsimonious' / 'Stingy' (reluctant to spend even when necessary).",
        "Neutral: 'Economical'."
      ],
      "exceptions": [
        "Never pair a derogatory word as the synonym for a laudatory term."
      ]
    },
    {
      "rule": "Root Word Etymology (Greek and Latin roots): Break down unfamiliar academic vocabulary into roots, prefixes, and suffixes.",
      "examples": [
        "'Bene-' (good/well) -> Benevolent (kind), Benefactor (patron), Benediction (blessing).",
        "'Mal-' (bad/evil) -> Malevolent (spiteful), Malicious (harmful), Malady (illness).",
        "'Chron-' (time) -> Chronological (ordered in time), Anachronistic (out of date)."
      ],
      "exceptions": [
        "Watch out for false friends where modern meanings have evolved away from literal roots."
      ]
    },
    {
      "rule": "Contextual register and formal usage in administrative English.",
      "examples": [
        "'Authenticate' (verify/substantiate) in official records.",
        "'Mitigate' (alleviate/lessen) administrative hardship or suffering.",
        "'Diligent' (assiduous, painstaking, hardworking) in office duties."
      ],
      "exceptions": [
        "Colloquial words are rarely the intended synonyms in state service examinations."
      ]
    }
  ],
  "commonMistakes": [
    "Selecting a word from a different part of speech (e.g. choosing a verb when an adjective is asked).",
    "Selecting an antonym by mistake because the opposite word is familiar and prominent in memory.",
    "Overlooking the degree of intensity (e.g. confusing 'annoyed' with 'furious').",
    "Confusing words that look similar in spelling but differ in meaning (e.g. ingenious vs ingenuous).",
    "Choosing an informal slang term in an examination expecting formal standard English."
  ],
  "examTricks": [
    "Tone Polarity Test: If the target word has an obvious positive tone (+), immediately eliminate all negative (-) choices.",
    "Elimination of 3 Synonyms: Often, three options will be exact synonyms of each other; the unique fourth option is usually the correct answer.",
    "Prefix Clues: Un-, In-, Dis-, Mis- indicate negation or reversal; Bene-, Eu- indicate goodness; Mal-, Dys- indicate badness/disorder."
  ],
  "memoryTricks": [
    "BENE = BENEFIT (Kind/Good).",
    "MAL = MALFUNCTION (Harmful/Bad).",
    "FRUGAL = WISE; MISER = CRIES (Miser hates spending, Frugal spends smartly)."
  ],
  "revision": [
    "Synonyms must match grammatical category (noun with noun, adjective with adjective).",
    "Match the emotional polarity (positive, neutral, or negative).",
    "Use Greek and Latin roots to decipher unfamiliar vocabulary.",
    "Beware of choosing antonyms under timed exam pressure."
  ],
